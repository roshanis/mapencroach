{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/ruff check .)",
      "Bash(.venv/bin/python -m pytest -q)",
      "Bash(.venv/bin/pip-audit --skip-editable)",
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(npm audit --audit-level=high)"
    ]
  }
}
